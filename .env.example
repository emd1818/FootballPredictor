# Football Odds Predictor environment template
# Copy to .env and replace every placeholder with your own value.
# Never commit .env or real credentials.
DATABASE_URL=mysql://username:password@localhost:3306/football_odds_predictor
ODDS_API_KEY=your_odds_api_key_here
# Comma-separated The Odds API sport keys.
ODDS_LEAGUES=soccer_epl,soccer_spain_la_liga,soccer_italy_serie_a,soccer_germany_bundesliga,soccer_france_ligue_one,soccer_netherlands_eredivisie,soccer_brazil_campeonato,soccer_uefa_champs_league,soccer_uefa_europa_league,soccer_uefa_europa_conference_league
API_FOOTBALL_KEY=your_api_football_key_here
JWT_SECRET=replace_with_a_long_random_secret
VITE_APP_ID=your_oauth_app_id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://login.manus.im
OWNER_OPEN_ID=your_owner_open_id
OWNER_NAME=Your Name
BUILT_IN_FORGE_API_URL=https://api.manus.im/forge
BUILT_IN_FORGE_API_KEY=your_forge_api_key_here
VITE_FRONTEND_FORGE_API_KEY=your_frontend_forge_api_key_here
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im/forge
VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
VITE_ANALYTICS_WEBSITE_ID=your_analytics_website_id
# Scheduler controls. Set false when a separate worker owns scheduled jobs.
SCHEDULER_ENABLED=true
SCHEDULER_LOCK_NAME=football-odds-predictor:scheduler
# AI is explanation-only; model probabilities are calculated deterministically.
ENABLE_AI_REASONING=true
VITE_APP_TITLE=Football Odds Predictor
VITE_APP_LOGO=/logo.svg
# Historical Odds API archive is a paid-plan feature. Keep disabled unless explicitly used.
HISTORICAL_ARCHIVE_ENABLED=false
# Cost/quota controls for live odds ingestion
ODDS_REGIONS=eu,uk
ODDS_LEAGUES_PER_CYCLE=2
LIVE_PREDICTION_LIMIT=12
